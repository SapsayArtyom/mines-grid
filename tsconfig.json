{
    "compilerOptions": {
      "outDir": "./dist/",
      "noImplicitAny": true,
      "sourceMap": true,
      "module": "ESNext",
      "target": "es6",
      "jsx": "react-jsx",
      "allowJs": true,
      "moduleResolution": "node",
      "esModuleInterop": true,
      "allowSyntheticDefaultImports": true,
      // "baseUrl": ".",
      "plugins": [{ "name": "typescript-plugin-css-modules" }],
      "resolveJsonModule": true,
      "forceConsistentCasingInFileNames": true,
      "baseUrl": ".",
      "paths": {
        "*": ["./src/*"]
      }
    },
    "ts-node": {
        "compilerOptions": {
            "module": "CommonJS"
        }
    }
  }